#!/bin/sh
case "${1:-}" in
    start)   lighttpd -f /opt/etc/lighttpd/lighttpd.conf ;;
    stop)    pkill -x lighttpd 2>/dev/null || true ;;
    restart) pkill -x lighttpd 2>/dev/null || true; sleep 1; lighttpd -f /opt/etc/lighttpd/lighttpd.conf ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
